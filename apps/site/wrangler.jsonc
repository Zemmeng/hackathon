// site —— 一个 Worker 挂全部模块：/<模块>/public/… 是各模块 public/ 的原样拷贝（build.mjs 拷到 out/），/api/* 交给 T5 的 api Worker
// 部署只走 bash scripts/deploy.sh all（DEPLOYER，D-0929-1322）；它会跑 npm run deploy = node build.mjs && wrangler deploy
// 密钥不放这里：大模型 key 由部署人在 T5 的 api Worker 上 npx wrangler secret put <NAME>。详见 README.md、docs/deploy-cloudflare.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker 名 = workers.dev 链接前缀：https://hackathon-site.<账号子域>.workers.dev
  // DEPLOYER 可以改名（先在 Cloudflare 后台 Workers & Pages 看一眼有没有重名）；改完告诉 lead 更新 DEMO_URL
  "name": "hackathon-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // 比赛期间拿 demo 链接；赛后想关就改 false 再部署一次（D-10）
  "workers_dev": true,
  // 不给每次上传的版本单独开预览链接：少一批没人管、却能公开访问的入口
  "preview_urls": false,
  // 线上 console.log / 报错在 Cloudflare 后台 Workers Logs 里查，或 npx wrangler tail
  "observability": { "enabled": true },

  "assets": {
    // build.mjs 的产物（已 gitignore），不是源码；npm run dev / deploy 会先重新生成
    "directory": "out",
    "binding": "ASSETS",
    // /api/* 先进 Worker（转给 T5）；但 /api/public/* 是 apps/api/public/ 的静态文件（reader.js 等），照常走静态资源
    "run_worker_first": ["/api/*", "!/api/public/*"]
  },

  // ---- 接 T5 的 api Worker（D-0929-1436，T19 打开）----
  // service = apps/api/wrangler.jsonc 的 "name"（改名两边一起改，tests/config.test.mjs 查）。
  // hackathon.conf 的 DEPLOY_MODULES=api site：api 必须排在前面，绑定的目标 Worker 得先存在，否则部署报 Could not resolve service binding
  "services": [
    { "binding": "API", "service": "hackathon-api" }
  ]
}
