// sumo —— Worker hackathon-sumo + Cloudflare Container（现场 SUMO，T37，D-0930-1700）
// 只由 lead 在本机部署：colima 里的 Docker 要开着，cd apps/sumo && npx wrangler deploy（README.md §部署）。
// 故意不进 hackathon.conf 的 DEPLOY_MODULES：没 Docker 的机器跑 deploy.sh all 会失败。
// site 用服务绑定 SUMO 把 /api/sumo/* 转过来；这个 Worker 必须先于 site 的 SUMO 绑定部署，否则 site 部署报 Could not resolve service binding
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // = apps/site/wrangler.jsonc services 里 SUMO 的 service（改名两边一起改）
  "name": "hackathon-sumo",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // 不开 hackathon-sumo.<子域>.workers.dev：唯一入口是 site 的服务绑定（同源，不用 CORS）
  "workers_dev": false,
  // 不给每次上传的版本单独开预览链接
  "preview_urls": false,
  // 线上日志（容器启动 / 停止、转发出错）在 Cloudflare 后台 Workers Logs 里查，或 npx wrangler tail hackathon-sumo
  "observability": { "enabled": true },

  // 容器：image 是 Dockerfile，构建上下文是 apps/（Dockerfile 里 COPY web/tools/sumo/… 和实网要的 roads/public/cbd/*.json）
  // standard-4 = 4 vCPU / 12 GiB / 20 GB 盘（Cloudflare 容器上限）：跑满一小时时几个情景各开一个 SUMO 进程并行（SUMO_REAL_JOBS=4），
  // 1 核要约 1.5 分钟一次；lead 10-01 定「狠狠提升」、总预算 20 美元（内存按醒着计费，到评审结束约 1.5–3 美元）
  // max_instances 1：serve.py 的任务状态只在这一个实例里（worker.js 固定用 getContainer(…, 'main')）
  "containers": [
    {
      "class_name": "SumoContainer",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],

  // 容器类本身是个 Durable Object：绑定名 SUMO_CONTAINER（worker.js 读），类名 = worker.js 里 export 的 SumoContainer
  "durable_objects": {
    "bindings": [
      { "name": "SUMO_CONTAINER", "class_name": "SumoContainer" }
    ]
  },
  // 第一次部署声明这个 Durable Object 类（容器要 SQLite 存储的 DO）；已部署过的 tag 不能改，以后加类就追加 v2
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SumoContainer"] }
  ],

  // 每个 IP（CF-Connecting-IP）每分钟最多 3 次 POST /runs；period 只能是 10 或 60。namespace_id 是账号里随便取的正整数，别和别的 Worker 撞
  // 这个限流是每个 Cloudflare 机房各算各的、最终一致，不是精确计数；兜底还有忙闸（容器里同时 ≥ 2 个任务回 429）
  "ratelimits": [
    { "name": "SUMO_RL", "namespace_id": "3501", "simple": { "limit": 3, "period": 60 } }
  ]
}
