{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sim",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "python3 -m http.server ${PORT:-4174} -d apps/sim/public"],
      "port": 4174,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "python3 -m http.server ${PORT:-4175} -d apps/web/public"],
      "port": 4175,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd apps/api && npx wrangler dev --port ${PORT:-8788} --var MOCK:1"],
      "port": 8788,
      "autoPort": true
    },
    {
      "name": "site",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd apps/site && node build.mjs && npx wrangler dev --port ${PORT:-8790}"],
      "port": 8790,
      "autoPort": true
    }
  ]
}
