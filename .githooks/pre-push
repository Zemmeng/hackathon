#!/usr/bin/env bash
# .githooks/pre-push —— push 前兜底：不直推 main；只推当前 HEAD；检查不绿不推
#
# 用途：在没有分支保护时兜住三件事——
#       [1] 目标是 refs/heads/main（含删除 main）且没设 ALLOW_MAIN=1 → 拒绝，提示先开分支
#       [2] 要推的提交不是当前 HEAD → 拒绝，提示切到该分支再推
#           （check.sh 查的是当前工作区，推别的分支等于没查）
#       [3] 跑 BRANCH=<被推的分支> CHECK_TEST_TIMEOUT=70 bash scripts/check.sh --quick（整体限时 90 秒）
#           有 ❌ 或缺「======== 汇总」行 → 拒绝并打印汇总节
#           单个 test.sh 限时比整体短 20 秒：死循环的测试先被 check 判 [5] ❌，不会走到下面的超时放行
#           脚本不存在 → ⚠️ 放行；整体超时 → ⚠️ 放行（CI 会跑全量）
# 什么时候触发：git push 时自动触发（前提：git config core.hooksPath .githooks，setup.sh 会做）。
#       git 从 stdin 每行传入：<local ref> <local sha> <remote ref> <remote sha>
# 怎么绕过：
#       lead 的小改动直推 main：ALLOW_MAIN=1 git push   （commit 里写原因）
#       紧急时整个跳过：git push --no-verify   （必须在 PR 里说明；CI 仍会再查）
# 退出码：0 放行；1 拒绝
# 兼容 macOS 自带 bash 3.2（没有 timeout 命令：后台运行 + kill -0 轮询）和 ubuntu。
set -uo pipefail

LIMIT_S=90
ZERO=0000000000000000000000000000000000000000

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

head_sha=$(git rev-parse -q --verify HEAD 2>/dev/null || true)
cur_branch=$(git symbolic-ref --short -q HEAD 2>/dev/null || true)

# ---- 读 stdin：要推哪些 ref ----
to_main=0
has_update=0
not_head=""
push_branch=""
while read -r lref lsha rref rsha; do
  [ -n "${rref:-}" ] || continue
  [ "$rref" = "refs/heads/main" ] && to_main=1
  case "${lsha:-}" in
    "$ZERO"|"") continue ;;   # 删除远端 ref：没有新代码可查
  esac
  has_update=1
  # 附注 tag 的 sha 是 tag 对象，剥到它指向的提交再比
  commit=$(git rev-parse -q --verify "${lsha}^{commit}" 2>/dev/null || echo "$lsha")
  if [ "$commit" != "$head_sha" ]; then
    not_head="$not_head    $lref → $rref
"
  fi
  if [ -z "$push_branch" ]; then
    case "$lref" in
      refs/heads/*) push_branch=${lref#refs/heads/} ;;
      *) push_branch=$cur_branch ;;          # git push origin HEAD / 推 tag：用当前分支名
    esac
    if [ -z "$push_branch" ]; then
      case "$rref" in refs/heads/*) push_branch=${rref#refs/heads/} ;; esac
    fi
  fi
done

# ---- [1] 不直推 main ----
if [ "$to_main" -eq 1 ] && [ "${ALLOW_MAIN:-}" != "1" ]; then
  echo "🚫 pre-push：不直推 main。先开分支再推，然后开 PR："
  echo "    git switch -c <handle>/<模块>/T<n>-<slug>"
  echo "    git push -u origin HEAD"
  echo "    gh pr create --fill"
  echo "  lead 的小改动确实要直推：ALLOW_MAIN=1 git push   （commit 里写原因）"
  exit 1
fi

[ "$has_update" -eq 1 ] || exit 0

# ---- [2] 只推当前 HEAD ----
if [ -n "$not_head" ]; then
  echo "🚫 pre-push：要推的提交不是当前 HEAD（当前在 ${cur_branch:-detached HEAD}）。"
  echo "  检查只能查当前工作区，推别的分支等于没查。下面这些被拒："
  printf '%s' "$not_head"
  echo "  切到该分支再推："
  echo "    git switch <分支名> && git push -u origin HEAD"
  echo "  （git push --all 或 push.default=matching 一次推多个分支也会被拦，请逐个切过去推）"
  exit 1
fi

# ---- [3] check.sh --quick，整体限时 90 秒 ----
if [ ! -f scripts/check.sh ]; then
  echo "⚠️ pre-push：没找到 scripts/check.sh，跳过检查（放行）"
  exit 0
fi

test_timeout=$((LIMIT_S - 20))
[ "$test_timeout" -ge 10 ] || test_timeout=10

out=$(mktemp "${TMPDIR:-/tmp}/pre-push-check.XXXXXX") || { echo "⚠️ pre-push：mktemp 失败，跳过检查（放行）"; exit 0; }
trap 'rm -f "$out"' EXIT

echo "⏳ pre-push：BRANCH=${push_branch:-（未知）} bash scripts/check.sh --quick（整体最多 ${LIMIT_S} 秒，单个测试 ${test_timeout} 秒）"
# set -m：让 check.sh 自成一个进程组，超时时连它起的测试子进程一起杀掉
set -m
BRANCH="$push_branch" CHECK_TEST_TIMEOUT="$test_timeout" bash scripts/check.sh --quick </dev/null >"$out" 2>&1 &
pid=$!
set +m

# 每秒把新增的输出打出来：长检查也能看到进度
shown=0
waited=0
timed_out=0
flush_new() {
  local n
  n=$(wc -l <"$out" | tr -d ' ')
  if [ "${n:-0}" -gt "$shown" ]; then
    sed -n "$((shown + 1)),${n}p" "$out"
    shown=$n
  fi
}
# 超时被杀时 bash 会往 stderr 打一行「Terminated」作业通知：轮询和收尸期间把 stderr 临时静音
exec 3>&2 2>/dev/null
while kill -0 "$pid"; do
  if [ "$waited" -ge "$LIMIT_S" ]; then
    timed_out=1
    kill -TERM -- "-$pid" || kill -TERM "$pid"
    sleep 1
    kill -KILL -- "-$pid"
    break
  fi
  sleep 1
  waited=$((waited + 1))
  flush_new
done
wait "$pid"
code=$?
exec 2>&3 3>&-
flush_new
# 最后一行没有换行符时 wc -l 数不到它，补打一次
if [ -s "$out" ] && [ -n "$(tail -c 1 "$out")" ]; then
  tail -n 1 "$out"; echo ""
fi

if [ "$timed_out" -eq 1 ]; then
  echo "⚠️ pre-push：check.sh --quick 超过 ${LIMIT_S} 秒，已终止，这次放行（CI 会跑全量；本地可以单独跑 bash scripts/check.sh --quick 看哪步慢）"
  exit 0
fi

summary=$(grep -E '^======== 汇总' "$out" | tail -n 1)
nfail=$(printf '%s\n' "$summary" | sed -nE 's/^======== 汇总 ([0-9]+) ❌.*/\1/p')

if [ -z "$summary" ] || [ "$code" -ne 0 ] || [ "${nfail:-1}" != "0" ]; then
  echo ""
  echo "🚫 pre-push：检查没过，拒绝 push。汇总节："
  echo "----------------------------------------"
  if [ -n "$summary" ]; then
    # check.sh 的汇总节 = 汇总行 + 所有 ❌/⚠️ 行原样再列一遍
    sed -n '/^======== 汇总/,$p' "$out"
  else
    echo "（check.sh 没有输出「======== 汇总」行，退出码 $code —— 多半是崩了，按失败处理）"
  fi
  echo "----------------------------------------"
  echo "  完整输出：logs/last-check.txt"
  echo "  修好后重新 push；紧急时 git push --no-verify，但必须在 PR 里说明，CI 仍会再查。"
  exit 1
fi

echo "✅ pre-push：检查通过"
exit 0
